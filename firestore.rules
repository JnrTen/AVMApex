rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read any user profile and write their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Factory production records: allow authenticated plant personnel to read & write
    match /paint_scans/{scanId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /checkpoints/{checkpointId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /defects/{defectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /production_buses/{busId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /material_stock/{stockId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /weld_inspections/{inspectionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /chat_messages/{messageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    // Default catch-all for authenticated plant technicians
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
